# Base URL (including /api/v1) of the virtual_card backend's public API.
# Used by src/lib/public-plans.ts to fetch the live pricing catalog for the
# /pricing page, the homepage SEO schema, and the checkout page -- so a
# price/feature change in the admin Plans page shows up here without a
# redeploy. No auth needed (POST /plans/readAllPlans is public), CORS is
# wide open on that API. Defaults to https://api.qwicksite.com/api/v1 if unset.
QWICKSITE_API_URL=https://api.qwicksite.com/api/v1
